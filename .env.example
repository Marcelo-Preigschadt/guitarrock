# Defaults are suitable when the same server serves API + frontend.
RIFFSYNC_DATA=./data
RIFFSYNC_DEVICE=auto
MAX_UPLOAD_MB=200
MAX_DURATION_SECONDS=1200
JOB_TIMEOUT_SECONDS=7200
RETENTION_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
SEPARATION_SEGMENT_SECONDS=4
LYRICS_MODEL=small
# Empty: recognize the language automatically; pt/en/es can be forced.
LYRICS_LANGUAGE=
